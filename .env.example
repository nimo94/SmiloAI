# =================================================================
# SmiloAI Engine v5.0 — Environment Configuration (.env.example)
# =================================================================
# Copy this file to .env and insert your actual API keys/tokens.
# DO NOT commit your actual .env file to version control!

# Groq API Key for real-time LLM Clinical Narrative generation
GROQ_API_KEY="YOUR_GROQ_API_KEY_HERE"

# Dropbox Cloud Sync OAuth2 Credentials (Optional - for remote model federation)
DROPBOX_APP_KEY="YOUR_DROPBOX_APP_KEY_HERE"
DROPBOX_APP_SECRET="YOUR_DROPBOX_APP_SECRET_HERE"
DROPBOX_REFRESH_TOKEN="YOUR_DROPBOX_REFRESH_TOKEN_HERE"
DROPBOX_FOLDER_PATH="/path/to/remote/cloud/models"
